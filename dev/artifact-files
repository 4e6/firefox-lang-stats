#!/usr/bin/env python3
"""List the repository source files that ship in a Firefox release, from the Breakpad symbol files of its binaries.

For each version (see docs/reference/symbols/README.md, steps 1-6):

  capture  stream the Linux x86_64 release tarball from archive.mozilla.org, read the GNU build id of every ELF file in
           it, turn it into the symbol-server debug id, and read only the FILE header of
           https://symbols.mozilla.org/<module>/<debug id>/<module>.sym with gzip range requests. The unfiltered header
           of each module is kept in RAW/<version>/<module>.files.gz and RAW/<version>/manifest.json (written last, so
           a version without it is captured again).
  derive   offline: read RAW/<version>, keep only repository paths, deduplicate, sort, write OUT/<version>.txt.
           Kept: hg:hg.mozilla.org/<repo>:<path>:<rev> and git:github.com/mozilla-firefox/firefox:<path>:<sha>.
           Dropped: s3:gecko-generated-sources (generated code), other repositories (git:github.com/rust-lang/rust),
           absolute paths (toolchain, sysroot, Rust crates, /builds/worker/workspace/obj-build), obj-*/ and <...>.

A version whose RAW/<version>/manifest.json exists is never fetched again, so filters can be fixed and re-derived after
the symbols have expired. Python 3 standard library only.

usage: dev/artifact-files [--raw DIR] [--out DIR] [--derive-only] [--force] [--stats] VERSION...
"""
import argparse, bz2, gzip, json, lzma, os, re, struct, sys, tarfile, time, urllib.error, urllib.request, zlib

ARCHIVE = 'https://archive.mozilla.org/pub/firefox/releases/{v}/linux-x86_64/en-US/firefox-{v}.tar.{ext}'
TECKEN = 'https://symbols.mozilla.org/{m}/{d}/{m}.sym'
UA = 'firefox-lang-stats/artifact-files (+https://github.com/4e6/firefox-lang-stats)'
HEADER = (b'MODULE', b'INFO', b'FILE')
CHUNK = 2 << 20

# Repository paths: the source-server prefixes Breakpad writes for mozilla-central builds.
#   45-146: hg:hg.mozilla.org/<repo>:<path>:<rev>      147+: git:github.com/mozilla-firefox/firefox:<path>:<sha>
REPO_RE = re.compile(r'^(hg:hg\.mozilla\.org/[^:]+|git:github\.com/mozilla-firefox/firefox):(.*):([0-9a-f]{12,40})$')


def log(*a):
    print(time.strftime('%H:%M:%S'), *a, file=sys.stderr, flush=True)


def urlopen(req, timeout=120, tries=4):
    for i in range(tries):
        try:
            return urllib.request.urlopen(req, timeout=timeout)
        except urllib.error.HTTPError as e:
            if e.code in (404, 403, 410, 416) or i == tries - 1:
                raise
        except (urllib.error.URLError, OSError):
            if i == tries - 1:
                raise
        time.sleep(2 ** i * 2)


# ---------------------------------------------------------------- ELF


def elf_build_id(data):
    """GNU build id from the PT_NOTE segments of a 64-bit little-endian ELF, or None."""
    if data[:4] != b'\x7fELF' or data[4] != 2 or data[5] != 1:
        return None
    e_phoff, = struct.unpack('<Q', data[32:40])
    e_phentsize, e_phnum = struct.unpack('<HH', data[54:58])
    for i in range(e_phnum):
        p = data[e_phoff + i * e_phentsize:e_phoff + (i + 1) * e_phentsize]
        typ, = struct.unpack('<I', p[:4])
        off, = struct.unpack('<Q', p[8:16])
        sz, = struct.unpack('<Q', p[32:40])
        if typ != 4:
            continue
        q = off
        while q + 12 <= off + sz:
            nsz, dsz, nt = struct.unpack('<III', data[q:q + 12])
            name = data[q + 12:q + 12 + nsz]
            dstart = q + 12 + ((nsz + 3) & ~3)
            if nt == 3 and name.rstrip(b'\0') == b'GNU':
                return data[dstart:dstart + dsz]
            q = dstart + ((dsz + 3) & ~3)
    return None


def debug_id(build_id):
    """Breakpad debug id: first 16 bytes as a GUID (first three fields byte-swapped), upper hex, plus age 0."""
    g = (build_id + b'\0' * 16)[:16]
    return (g[3::-1] + g[5:3:-1] + g[7:5:-1] + g[8:16]).hex().upper() + '0'


def tarball_elves(version):
    """Stream the release tarball; return (url, [(tar path, size, build id hex or None)]) for every ELF file."""
    for ext in ('xz', 'bz2'):
        url = ARCHIVE.format(v=version, ext=ext)
        try:
            r = urlopen(urllib.request.Request(url, headers={'User-Agent': UA}))
            break
        except urllib.error.HTTPError as e:
            if e.code != 404:
                raise
    else:
        raise RuntimeError(f'no linux-x86_64 tarball for {version}')
    dec = lzma.LZMAFile(r) if ext == 'xz' else bz2.BZ2File(r)
    elves = []
    with tarfile.open(fileobj=dec, mode='r|') as tf:
        for m in tf:
            if not m.isfile() or m.size < 64:
                continue
            f = tf.extractfile(m)
            head = f.read(4)
            if head != b'\x7fELF':
                continue
            data = head + f.read()
            bid = elf_build_id(data)
            elves.append((m.name, m.size, bid.hex().upper() if bid else None))
    r.close()
    return url, elves


# ---------------------------------------------------------------- symbol server


def sym_header(module, did):
    """Header lines (MODULE, INFO, FILE) of a .sym on the symbol server, or None if it is not there.

    Accept-Encoding: gzip is required: without it the server ignores Range and sends the whole file decompressed
    (723 MB for libxul.so). Each response is read in pieces and dropped as soon as the FILE section has ended, so even
    a server that ignores Range costs only what is read."""
    url = TECKEN.format(m=module, d=did)
    pos, lines, buf, nbytes = 0, [], b'', 0
    d = None
    while True:
        req = urllib.request.Request(url, headers={'Accept-Encoding': 'gzip', 'Range': f'bytes={pos}-{pos + CHUNK - 1}',
                                                   'User-Agent': UA})
        try:
            r = urlopen(req)
        except urllib.error.HTTPError as e:
            if e.code == 404:
                return None, nbytes
            if e.code == 416:  # range past the end: the file ended exactly at the previous chunk
                break
            raise
        gz = r.headers.get('Content-Encoding', '') == 'gzip'
        if d is None:
            d = zlib.decompressobj(31) if gz else None
        if r.status == 200 and pos > 0:
            raise RuntimeError(f'{url}: server ignored Range (status 200 at offset {pos})')
        got, done = 0, False
        while not done:
            c = r.read(256 << 10)
            if not c:
                break
            got += len(c); nbytes += len(c); pos += len(c)
            buf += d.decompress(c) if d else c
            *full, buf = buf.split(b'\n')
            for l in full:
                if l.startswith(HEADER):
                    lines.append(l.decode('utf-8', 'replace'))
                else:
                    done = True
                    break
        r.close()
        if done or got < CHUNK or r.status == 200:
            break
    if buf.startswith(HEADER) and not done:
        lines.append(buf.decode('utf-8', 'replace'))
    return lines, nbytes


def capture(version, rawdir):
    vdir = os.path.join(rawdir, version)
    man = os.path.join(vdir, 'manifest.json')
    if os.path.exists(man):
        return json.load(open(man))
    os.makedirs(vdir, exist_ok=True)
    t = time.time()
    url, elves = tarball_elves(version)
    log(version, 'tarball', url, len(elves), 'ELF files', f'{time.time() - t:.0f}s')
    modules, used = [], set()
    for path, size, bid in sorted(elves):
        name = os.path.basename(path)
        ent = {'path': path, 'module': name, 'size': size, 'code_id': bid}
        if bid is None:
            ent['status'] = 'no-build-id'
            modules.append(ent)
            continue
        did = debug_id(bytes.fromhex(bid))
        ent['debug_id'] = did
        lines, nbytes = sym_header(name, did)
        ent['bytes'] = nbytes
        if lines is None:
            ent['status'] = 'not-on-symbol-server'
        else:
            if not lines or not lines[0].startswith('MODULE') or did not in lines[0]:
                raise RuntimeError(f'{version} {name}: unexpected first line {lines[:1]}')
            fn = name if name not in used else f'{name}.{len(used)}'
            used.add(fn)
            with gzip.open(os.path.join(vdir, fn + '.files.gz'), 'wt', encoding='utf-8') as f:
                f.write('\n'.join(lines) + '\n')
            ent['status'] = 'read'
            ent['raw'] = fn + '.files.gz'
            ent['file_records'] = sum(1 for l in lines if l.startswith('FILE '))
        modules.append(ent)
        log(version, name, ent['status'], ent.get('file_records', ''), nbytes)
    m = {'version': version, 'tarball': url, 'captured': time.strftime('%Y-%m-%dT%H:%M:%SZ', time.gmtime()),
         'modules': modules}
    tmp = man + '.tmp'
    json.dump(m, open(tmp, 'w'), indent=1)
    os.replace(tmp, man)
    log(version, 'captured', f'{time.time() - t:.0f}s')
    return m


# ---------------------------------------------------------------- derive


def classify(name):
    """Return the repository path of a FILE record's name, or None with a reason for dropping it."""
    m = REPO_RE.match(name)
    if not m:
        if name.startswith('s3:'):
            return None, 's3-generated'
        if name.startswith(('hg:', 'git:')):
            return None, 'other-repo'
        return None, 'not-repo'  # absolute paths: toolchain, sysroot, Rust std and crates, /builds/worker/...
    path = m.group(2)
    if path.startswith('<'):
        return None, 'pseudo'
    if path.startswith('obj-') or path.startswith('/') or '/../' in path or path.startswith('../'):
        return None, 'objdir'
    return (m.group(1), path, m.group(3)), None


def derive(version, rawdir):
    """Paths, and statistics, from RAW/<version>."""
    vdir = os.path.join(rawdir, version)
    man = json.load(open(os.path.join(vdir, 'manifest.json')))
    paths, dropped, revs, repos = set(), {}, {}, set()
    for ent in man['modules']:
        if ent['status'] != 'read':
            continue
        with gzip.open(os.path.join(vdir, ent['raw']), 'rt', encoding='utf-8') as f:
            for l in f:
                if not l.startswith('FILE '):
                    continue
                name = l.rstrip('\n').split(' ', 2)[2]
                got, why = classify(name)
                if got is None:
                    dropped[why] = dropped.get(why, 0) + 1
                    continue
                repo, path, rev = got
                repos.add(repo); paths.add(path); revs[rev] = revs.get(rev, 0) + 1
    read = [e['module'] for e in man['modules'] if e['status'] == 'read']
    skipped = [e['module'] + ('' if e['status'] == 'not-on-symbol-server' else f" ({e['status']})")
               for e in man['modules'] if e['status'] != 'read']
    xul = [e for e in man['modules'] if e['module'] == 'libxul.so']
    return sorted(paths), {'version': version, 'paths': len(paths), 'elf': len(man['modules']), 'read': read,
                           'skipped': skipped, 'libxul_debug_id': xul[0].get('debug_id') if xul else None,
                           'repos': sorted(repos), 'revs': revs, 'dropped': dropped}


def main():
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument('versions', nargs='*')
    ap.add_argument('--raw', default=os.path.expanduser('~/artifact-raw'), help='raw FILE headers (default ~/artifact-raw)')
    ap.add_argument('--out', default='data/artifact-files', help='where <version>.txt is written')
    ap.add_argument('--derive-only', action='store_true', help='never use the network; derive from RAW only')
    ap.add_argument('--force', action='store_true', help='rewrite OUT/<version>.txt even if it exists')
    ap.add_argument('--stats', action='store_true', help='print derive statistics as JSON lines')
    a = ap.parse_args()
    os.makedirs(a.out, exist_ok=True)
    failed = []
    for v in a.versions:
        out = os.path.join(a.out, v + '.txt')
        if os.path.exists(out) and not a.force and not a.stats:
            log(v, 'exists, skipped')
            continue
        try:
            if not os.path.exists(os.path.join(a.raw, v, 'manifest.json')):
                if a.derive_only:
                    log(v, 'no raw capture'); failed.append(v); continue
                capture(v, a.raw)
            paths, st = derive(v, a.raw)
        except Exception as e:
            log(v, 'FAILED', repr(e)); failed.append(v); continue
        if a.stats:
            print(json.dumps(st), flush=True)
        if not os.path.exists(out) or a.force:
            tmp = out + '.tmp'
            open(tmp, 'w').write(''.join(p + '\n' for p in paths))
            os.replace(tmp, out)
            log(v, 'wrote', out, len(paths), 'paths;', len(st['read']), 'modules read, skipped', st['skipped'])
    if failed:
        log('FAILED:', ' '.join(failed))
        sys.exit(1)


if __name__ == '__main__':
    main()
